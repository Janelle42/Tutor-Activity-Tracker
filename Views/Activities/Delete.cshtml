@model Tutor_Activity_Tracker.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="page-header">
    <div>
        <h1>Delete Activity</h1>
        <p>Remove this tutoring activity from the tracker.</p>
    </div>
</div>

<div class="delete-card">

    <div class="delete-message">

        <h2>Are you sure?</h2>

        <p>
            You are about to delete this activity.
            This action cannot be undone.
        </p>

    </div>

    <div class="details-grid">

        <div class="detail-item">
            <div class="detail-label">Activity Type</div>
            <div class="detail-value">@Model.ActivityType</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Module</div>
            <div class="detail-value">@Model.Module</div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Date</div>
            <div class="detail-value">
                @Model.Date.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="detail-item">
            <div class="detail-label">Number of Students</div>
            <div class="detail-value">
                @Model.StudentsReached
            </div>
        </div>

    </div>

    <form asp-action="Delete" class="form-actions">

        <input type="hidden" asp-for="ActivityId" />

        <a asp-action="Index" class="secondary-button">
            Cancel
        </a>

        <button type="submit" class="delete-button">
            Delete Activity
        </button>

    </form>

</div> 